{
  "name": "animemind",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "spine": "tsx --env-file-if-exists=.env.local scripts/spine-report.ts",
    "seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "backfill-art": "tsx --env-file-if-exists=.env.local scripts/backfill-art.mts",
    "dedupe:works": "tsx --env-file-if-exists=.env.local scripts/dedupe.mts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@tanstack/react-query": "^5.108.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "gsap": "^3.15.1",
    "idb-keyval": "^6.2.2",
    "jose": "^6.2.17",
    "lucide-react": "^0.545.0",
    "next": "16.4.6",
    "postgres": "^3.4.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.3.1",
    "ulid": "^3.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vite": "^7.3.8",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@11.6.0"
}
